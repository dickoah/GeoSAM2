# SegviGen — configuration template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# The .env file is NOT committed to git (.gitignore).
#
# Usage:
#   cp .env.dist .env
#   # edit .env
#   uvicorn server:app --host 0.0.0.0 --port 7860
# ─────────────────────────────────────────────────────────────────────────────


# ── API Keys ──────────────────────────────────────────────────────────────────

# Gemini API key — required only for "Full + 2D Map" mode (guidance map generation).
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=


# ── Server ────────────────────────────────────────────────────────────────────

# HTTP host and port (uncomment to override defaults).
# SERVER_HOST=0.0.0.0
# SERVER_PORT=7860
