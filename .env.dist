# GeoSAM2 evaluation bench — configuration template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# The .env file is NOT committed to git (.gitignore).
#
# Usage:
#   cp .env.dist .env
#   # edit .env
#   python -m app.server      # evaluation bench  -> http://127.0.0.1:7861
#   python -m app.mask_lab    # VLM mask lab      -> http://127.0.0.1:7862
# ─────────────────────────────────────────────────────────────────────────────


# ── API keys ──────────────────────────────────────────────────────────────────

# Gemini API key — required only for the VLM stage (describe + part map).
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=


# ── Development ───────────────────────────────────────────────────────────────

# DEV mode, on unless set to 0. A failing stage is logged with its traceback and
# re-raised where it happened, instead of being folded into an error string the
# caller only reads once the run is over. Turn it off to restore
# GeoSAM2Segmenter.process's never-raises contract.
# GEOSAM2_DEV=1

# Log level. DEBUG adds the per-part pixel coverage of a generated mask.
# GEOSAM2_LOG_LEVEL=INFO


# ── Servers ───────────────────────────────────────────────────────────────────

# Host and port for each app (uncomment to override the defaults shown).
# GEOSAM2_APP_HOST=127.0.0.1
# GEOSAM2_APP_PORT=7861
# GEOSAM2_MASK_LAB_HOST=127.0.0.1
# GEOSAM2_MASK_LAB_PORT=7862
